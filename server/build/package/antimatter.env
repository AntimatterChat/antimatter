# Antimatter server settings, read by antimatter.service. Restart after a change:
#   sudo systemctl restart antimatter
#
# Any setting of config.json can be set here as AM_<SECTION>_<SETTING> (for example
# SqlSettings.DataSource is AM_SQLSETTINGS_DATASOURCE). A setting set here can't be changed in the
# System Console. See https://antimatter.chat/docs/admins/configuration.html
# This file holds the database password: keep it readable by root only. Upgrades keep it.

# PostgreSQL 15 or newer (required). Create the user and the database first, see
# https://antimatter.chat/docs/admins/install.html
AM_SQLSETTINGS_DRIVERNAME=postgres
#AM_SQLSETTINGS_DATASOURCE=postgres://antimatter:a-long-password@localhost:5432/antimatter?sslmode=disable&connect_timeout=10

# The address users open Antimatter at, e.g. behind a reverse proxy with HTTPS.
#AM_SERVICESETTINGS_SITEURL=https://chat.example.com

# The server listens on port 8065 by default.
#AM_SERVICESETTINGS_LISTENADDRESS=:8065

# GIFs and stickers: the bundled GIFs app uses the GIF server (the gifs-server package, installed
# alongside by default). Its API key is in /etc/gifs-server/api-keys: copy it here
# (sudo cat /etc/gifs-server/api-keys), or set both in System Console > Plugins > GIFs.
AM_GIFS_SERVICE_URL=http://127.0.0.1:8080/v2
#AM_GIFS_API_KEY=
