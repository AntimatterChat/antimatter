exports[`components/PushSettings should match snapshot, no push notification server (the default) 1`] = `
<div>
  <form
    class="form-horizontal"
    role="form"
  >
    <div
      class="wrapper--fixed"
    >
      <div
        class="admin-console__header"
        data-testid="admin-console-header"
      >
        Push Notification Server
      </div>
      <div
        class="admin-console__wrapper"
      >
        <div
          class="admin-console__content"
        >
          <div
            class="form-group"
            data-testid="pushNotificationServerType"
          >
            <label
              class="control-label col-sm-4"
              for="pushNotificationServerType"
            >
              Enable Push Notifications: 
            </label>
            <div
              class="col-sm-8"
            >
              <select
                class="form-control"
                data-testid="pushNotificationServerTypedropdown"
                id="pushNotificationServerType"
              >
                <option
                  value="off"
                >
                  Do not send push notifications
                </option>
                <option
                  value="custom"
                >
                  Send push notifications through your own push proxy
                </option>
              </select>
              <div
                class="help-text"
                data-testid="pushNotificationServerTypehelp-text"
              >
                Please see 
                <a
                  href="https://github.com/AntimatterChat/push-proxy#self-hosting"
                  location="push_settings"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  documentation on push notifications
                </a>
                 to learn more about setup options.
              </div>
            </div>
          </div>
          <div
            class="form-group"
            data-testid="pushNotificationServer"
          >
            <label
              class="control-label col-sm-4"
              data-testid="pushNotificationServerlabel"
              for="pushNotificationServer"
            >
              Push Notification Server:
            </label>
            <div
              class="col-sm-8"
            >
              <input
                class="form-control"
                data-testid="pushNotificationServerinput"
                disabled=""
                id="pushNotificationServer"
                maxlength="-1"
                placeholder="E.g.: \\"https://push.example.com\\""
                type="text"
                value=""
              />
              <div
                class="help-text"
                data-testid="pushNotificationServerhelp-text"
              />
            </div>
          </div>
          <div
            class="form-group"
            data-testid="maxNotificationsPerChannel"
          >
            <label
              class="control-label col-sm-4"
              data-testid="maxNotificationsPerChannellabel"
              for="maxNotificationsPerChannel"
            >
              Large Channel Notification Threshold:
            </label>
            <div
              class="col-sm-8"
            >
              <input
                class="form-control"
                data-testid="maxNotificationsPerChannelnumber"
                id="maxNotificationsPerChannel"
                maxlength="-1"
                placeholder="E.g.: \\"1000\\""
                type="number"
                value="1000"
              />
              <div
                class="help-text"
                data-testid="maxNotificationsPerChannelhelp-text"
              >
                The maximum number of users that can be mentioned using @here, @all, or @channel. Above this limit, mentions and typing indicators are disabled, and users will see a system message if they try to use them.
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="admin-console-save"
      >
        <button
          class="btn btn-primary"
          data-testid="saveSetting"
          disabled=""
          id="saveSetting"
          type="submit"
        >
          <span>
            Save
          </span>
        </button>
        <div
          class="error-message"
        />
      </div>
    </div>
  </form>
</div>
`;

