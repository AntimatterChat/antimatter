                id="pushNotificationServer"
                maxlength="-1"
                placeholder="E.g.: \\"https://push.example.com\\""
                type="text"
                value="https://push.example.com"
              />
              <div
                class="help-text"
                data-testid="pushNotificationServerhelp-text"
              >
                The address of your Antimatter push proxy, which delivers notifications to the Antimatter apps for iOS and Android. 
                <a
                  href="https://github.com/AntimatterChat/push-proxy#self-hosting"
                  location="push_settings"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  Learn how to set it up
                </a>
                .
              </div>
            </div>
          </div>
          <div
            class="form-group"
