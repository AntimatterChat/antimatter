exports[`components/HeaderFooterTemplate should match snapshot with about link 1`] = `
<div>
  <div
    class="inner-wrap am-auth"
  >
    <a
      aria-label="Antimatter"
      class="am-auth-top"
      href="/"
    >
      <span
        class="am-auth-brand"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 64 64"
        >
          <ellipse
            class="am-auth-orbit-1"
            cx="32"
            cy="32"
            rx="25"
            ry="9.5"
            transform="rotate(45 32 32)"
          />
          <ellipse
            class="am-auth-orbit-2"
            cx="32"
            cy="32"
            rx="25"
            ry="9.5"
            transform="rotate(-45 32 32)"
          />
          <path
            class="am-auth-spark"
            d="M32 20.5Q33.9 30.1 43.5 32Q33.9 33.9 32 43.5Q30.1 33.9 20.5 32Q30.1 30.1 32 20.5Z"
          />
          <circle
            class="am-auth-matter"
            cx="14.32"
            cy="14.32"
            r="5.5"
          />
          <circle
            class="am-auth-anti"
            cx="49.68"
            cy="14.32"
            r="4.25"
          />
        </svg>
        Antimatter
      </span>
    </a>
    <div
      class="row content"
    />
    <div
      class="row footer"
    >
      <div
        class="footer-pane col-xs-12"
        id="footer_section"
      >
        <div
          class="col-xs-12"
        >
          <span
            class="pull-right footer-site-name"
            id="company_name"
          >
            Antimatter
          </span>
        </div>
        <div
          class="col-xs-12"
        >
          <span
            class="pull-right footer-link copyright"
            id="copyright"
          >
            © 2017 Antimatter contributors
          </span>
          <span
            class="pull-right"
          >
            <a
              class="footer-link"
              href="http://testaboutlink"
              id="about_link"
              location="header_footer_template"
              rel="noopener noreferrer"
              target="_blank"
            >
              About
            </a>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
`;

