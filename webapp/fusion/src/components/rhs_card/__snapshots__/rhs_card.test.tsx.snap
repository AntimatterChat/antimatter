                            cx="14.32"
                            cy="14.32"
                            fill="#6D28D9"
                            r="5.5"
                          />
                          <circle
                            cx="49.68"
                            cy="14.32"
                            fill="#FFFFFF"
                            r="4.25"
                            stroke="#0891B2"
                            stroke-width="2.5"
                          />
                        </svg>
                      </span>
                       
                      <div
                        class="user-popover"
                      >
                        Someone
                      </div>
                    </div>
                    <div
                      class="post-card--view-post"
                    >
                      <a
                        class="post__permalink"
                        href="/test-team-url/pl/123"
